{
  "name": "carwash-loyalty-backend",
  "version": "1.0.0",
  "description": "Car Wash Loyalty & Cash Collection Platform — Backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "migrate": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts -x ts",
    "seed": "knex seed:run --knexfile knexfile.ts",
    "test": "npm run test:e2e",
    "test:e2e": "ts-node -r tsconfig-paths/register tests/e2e-test.ts",
    "test:phase2": "ts-node -r tsconfig-paths/register tests/phase2-test.ts",
    "test:phase3": "ts-node -r tsconfig-paths/register tests/phase3-test.ts",
    "test:phase4": "ts-node -r tsconfig-paths/register tests/phase4-test.ts",
    "test:phase5": "ts-node -r tsconfig-paths/register tests/phase5-test.ts",
    "test:phase6": "ts-node -r tsconfig-paths/register tests/phase6-test.ts",
    "test:phase7": "ts-node -r tsconfig-paths/register tests/phase7-test.ts",
    "test:all": "npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase11 && npm run test:phase12 && npm run test:phase13 && npm run test:phase14 && npm run test:e2e",
    "test:phase11": "ts-node -r tsconfig-paths/register tests/phase11-test.ts",
    "test:phase12": "ts-node -r tsconfig-paths/register tests/phase12-test.ts",
    "test:phase13": "ts-node -r tsconfig-paths/register tests/phase13-test.ts",
    "test:phase14": "ts-node -r tsconfig-paths/register tests/phase14-test.ts"
  },
  "dependencies": {
    "@types/helmet": "^0.0.48",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
