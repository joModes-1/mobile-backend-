DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SEED_SYSADMIN_USERNAME=
SEED_SYSADMIN_EMAIL=
SEED_SYSADMIN_PASSWORD=
PORT=3000

# Optional — SMTP for outgoing email. Leave blank to run without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Car Wash Loyalty <no-reply@carwash.local>

# Where in-app issue reports are emailed. Leave blank to store them in the
# app only (they still appear on the Reports screen for sysadmins).
SUPPORT_EMAIL=

# Optional — look up a brand-new client's name from their phone number at
# sign-up, so they are never asked to type it. Leave both blank and new
# clients are simply called "Customer" until they rename themselves.
NAME_LOOKUP_URL=
NAME_LOOKUP_API_KEY=
