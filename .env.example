# Postgres connection URL. TLS is switched on automatically for Supabase,
# Render and Neon hosts, or whenever the URL has ?sslmode=require.
#
# Local:     postgresql://postgres:<password>@localhost:5432/era92
# Supabase:  use the SESSION POOLER string (Connect button, port 5432). The
#            "direct" host is IPv6-only and fails on most servers.
#            postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#            Percent-encode special characters in the password: @ -> %40,
#            , -> %2C, : -> %3A, / -> %2F, # -> %23.
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SEED_SYSADMIN_USERNAME=
SEED_SYSADMIN_EMAIL=
SEED_SYSADMIN_PASSWORD=
PORT=3000

# Email was removed from the platform entirely — no SMTP configuration is
# read any more. Auth codes go by SMS, and in-app issue reports are stored
# and shown on the Reports screen instead of being emailed.

# Optional — a brand-new client's registered name, from the mobile-money
# network that holds their number, so they are never asked to type it.
# A network left blank is skipped; with both blank, new clients get a
# generated name (user###). Sandbox URLs shown; live values come from MTN /
# Airtel when the business account is approved.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
